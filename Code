#function 1
def encrypter(message, shift, letters, special_characters):
  newlist = []
  message = message.casefold() #string method: makes string lowercase
  for letter_in_message in message:
    if letter_in_message in special_characters:
      encrypted_letter = '*'
    else:
      letter_index = letters.index(letter_in_message) #Takes the isoalted value and locates its index on the list
      encrypted_index = (letter_index + shift) % len(letters) #loops value back to 'a' if shift goes past 'z' (index + shift is greater than length of list)
      encrypted_letter = letters[encrypted_index] #turns index back into the value
    newlist.append(encrypted_letter) #Adds the encypted value to the new list
  new_message = ''.join(newlist) #string method: joins each value in the list together to make a string
  print(new_message)

#function 2
def decrypter(message, shift, letters, scpecial_characters):
  newlist = []
  message = message.casefold()
  for letter_in_message in message:
    if letter_in_message in special_characters:
      encrypted_letter = letter_in_message
    else:
      letter_index = letters.index(letter_in_message)
      encrypted_index = (letter_index - shift) % len(letters)
      encrypted_letter = letters[encrypted_index]
    newlist.append(encrypted_letter)
  new_message = ''.join(newlist)
  print(new_message)


